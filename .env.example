APP_ENV=local
APP_DEBUG=true
APP_KEY=replace-with-a-long-random-secret
APP_URL=http://localhost:8088
CORS_ORIGIN=http://localhost:4200
TOKEN_TTL_HOURS=24
DB_HOST=db
DB_PORT=3306
DB_DATABASE=marketing_os
DB_USERNAME=marketing_app
DB_PASSWORD=replace-with-a-strong-local-password
DB_ROOT_PASSWORD=replace-with-a-different-strong-root-password

# Registrazioni consentite per IP ogni ora (in produzione tienilo basso).
RATE_LIMIT_REGISTER_PER_HOUR=10
# Se impostato, per registrarsi serve questo codice (consigliato quando l'app è raggiungibile da internet).
REGISTRATION_INVITE_CODE=

# File caricati: cartella nel container e dimensione massima in MB.
STORAGE_PATH=/var/www/storage
UPLOAD_MAX_MB=20

# Inserzioni dei concorrenti dall'archivio inserzioni di Meta (Ad Library API). Serve un codice di accesso di un'app
# su developers.facebook.com, con l'identità verificata su facebook.com/ID. Meta non pubblica la spesa: l'app la stima.
META_AD_LIBRARY_TOKEN=
# true = dati di esempio quando non c'è il codice, per provare la sezione (sono segnalati come esempio).
META_AD_LIBRARY_SAMPLE=false
META_GRAPH_VERSION=v23.0

# Sponsorizzate pubblicate direttamente su Meta (Marketing API). Crea un'app di tipo "Business" su developers.facebook.com,
# aggiungi il prodotto "Marketing API" e "Facebook Login for Business" e, tra gli URI di reindirizzamento validi,
# APP_URL/api/v1/meta/callback. Finché l'app è in sviluppo funziona solo per chi ha un ruolo nell'app.
META_APP_ID=
META_APP_SECRET=
# ID della configurazione di Facebook Login for Business (Configurazioni); vuoto = permessi richiesti uno per uno.
META_LOGIN_CONFIG_ID=
# true = collegamento, pubblicazione e risultati di esempio, senza chiamare Meta (sono segnalati come esempio).
META_ADS_SAMPLE=false
# Tetto al budget giornaliero di una sponsorizzata pubblicata dall'app, in euro.
META_ADS_MAX_DAILY_BUDGET=100
# Indirizzo dell'app Angular, dove Facebook riporta dopo l'accesso (vuoto = CORS_ORIGIN).
FRONTEND_URL=

# Generazione AI. AI_PROVIDER: auto (Claude o Gemini se c'è la loro chiave, altrimenti bozze di esempio), claude, gemini, groq, fake.
AI_PROVIDER=auto
# Provider di riserva quando quello principale ha finito la quota o è sovraccarico (vuoto = nessuno).
AI_FALLBACK_PROVIDER=
# Richieste AI al giorno: in totale e per cliente (0 = nessun limite). I lavori automatici oltre il limite passano al giorno dopo.
AI_DAILY_LIMIT=20
AI_DAILY_LIMIT_PER_CLIENT=10
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max: più alto = più accurato ma più costoso e lento.
ANTHROPIC_EFFORT=medium
# Alternativa con piano gratuito: chiave da https://aistudio.google.com/apikey (sul piano gratuito Google può usare i dati inviati).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Riserva gratuita: chiave da https://console.groq.com/keys. Il modello deve supportare json_schema strict (gpt-oss).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
