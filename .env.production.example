# Produzione sul server: copia in .env (cp .env.production.example .env) e sostituisci ogni CAMBIA-…
# Guida completa in docs/DEPLOY-ORACLE.md. Le voci non elencate qui hanno gli stessi valori di .env.example.

# Usa sempre anche docker-compose.prod.yml (Caddy per l'HTTPS e riavvio automatico).
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
# Indirizzo pubblico senza https://, per esempio marketingos.duckdns.org.
DOMAIN=CAMBIA-tuonome.duckdns.org

APP_ENV=production
APP_DEBUG=false
# openssl rand -hex 32 — non cambiarla più: cifra i codici di accesso a Meta salvati nel database.
APP_KEY=CAMBIA-con-openssl-rand-hex-32
APP_URL=https://CAMBIA-tuonome.duckdns.org
CORS_ORIGIN=https://CAMBIA-tuonome.duckdns.org
FRONTEND_URL=https://CAMBIA-tuonome.duckdns.org
TOKEN_TTL_HOURS=24

DB_HOST=db
DB_PORT=3306
DB_DATABASE=marketing_os
DB_USERNAME=marketing_app
# openssl rand -hex 24 per ciascuna, diverse tra loro.
DB_PASSWORD=CAMBIA-con-openssl-rand-hex-24
DB_ROOT_PASSWORD=CAMBIA-con-un-altra-openssl-rand-hex-24

# Su internet la registrazione è chiusa: si registra solo chi conosce questo codice.
REGISTRATION_INVITE_CODE=CAMBIA-codice-invito
RATE_LIMIT_REGISTER_PER_HOUR=5

STORAGE_PATH=/var/www/storage
UPLOAD_MAX_MB=20

META_AD_LIBRARY_TOKEN=
META_AD_LIBRARY_SAMPLE=false
META_GRAPH_VERSION=v23.0
META_APP_ID=
# Meglio generarne una nuova su developers.facebook.com prima di metterla qui.
META_APP_SECRET=
META_LOGIN_CONFIG_ID=
META_ADS_SAMPLE=false
META_ADS_MAX_DAILY_BUDGET=100

AI_PROVIDER=auto
AI_FALLBACK_PROVIDER=
AI_DAILY_LIMIT=20
AI_DAILY_LIMIT_PER_CLIENT=10
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
GEMINI_API_KEY=
# Per la massima velocità: gemini-flash-lite-latest (risponde in pochi secondi, testi un po' meno curati).
GEMINI_MODEL=gemini-flash-latest
# Quanto "ragiona" prima di rispondere: minimal, low (consigliato, veloce), medium, high (più lento).
GEMINI_THINKING=low
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Abbonamento a Marketing OS: prova gratuita alla registrazione, poi pagamento con Stripe.
# Chiavi da https://dashboard.stripe.com/apikeys (in prova: sk_test_...). Senza chiave il pagamento è disattivato.
TRIAL_DAYS=10
PRICE_MONTHLY_CENTS=1500
PRICE_YEARLY_CENTS=12000
STRIPE_SECRET_KEY=
# Webhook: endpoint APP_URL/api/v1/stripe/webhook con gli eventi checkout.session.completed e customer.subscription.*
STRIPE_WEBHOOK_SECRET=
# Facoltativi: ID prezzo creati su Stripe (price_...). Vuoti = prezzi sopra.
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# Email (promemoria di scadenza della prova e dell'abbonamento). Qualsiasi server SMTP, ad esempio Brevo
# (smtp-relay.brevo.com, gratis fino a 300 email al giorno) o Gmail con una "password per le app".
# 587 = STARTTLS, 465 = SSL. Senza MAIL_HOST le email non partono (il popup nell'app resta).
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=Marketing OS
